# Cấu hình chỉ đọc bởi tiến trình Node trên máy Windows. Không thêm tiền tố VITE_ cho thông tin bí mật.
ROKSTATS_KINGDOM=2676
SYNC_INTERVAL_MINUTES=60
PORT=2676
# Tùy chọn: msedge hoặc chrome. Để trống sẽ dùng Chromium của Playwright.
BROWSER_CHANNEL=
# Trình duyệt hiện ra để đăng nhập Discord trên Windows; Edge thường có sẵn.
LOGIN_BROWSER_CHANNEL=msedge
# Nếu Playwright báo không tìm thấy Chromium, điền thư mục trình duyệt đã cài.
# PLAYWRIGHT_BROWSERS_PATH=C:/Users/<ten-ban>/AppData/Local/ms-playwright
